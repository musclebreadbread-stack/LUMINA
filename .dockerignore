# Keep local credentials and private runtime configuration out of build context.
.env
.env.*
**/.env
**/.env.*
*.pem
**/*.pem
.neon
.agents
.superpowers
docs
research
COMMERCIALIZATION-PLAN.md
DEVELOPMENT-PLAN.md
skills-lock.json
*.docx
/%normalizedDocx%
/32
*.mp3
!public/audio/bgm/digital-observatory.mp3
*.m4a
*.wav
scripts/_tmp_*.mjs

# Exclude dependencies and local build outputs.
.git
node_modules
**/node_modules
.next
**/.next
out
build
coverage
test-results
playwright-report
.vercel
.data-cache
raw
*.log
**/*.log
*.tsbuildinfo

# Drop PNG source assets; retain generated OG PNGs and route-required PNG inputs.
public/**/*.png
!public/*.png
!public/og/**/*.png
!public/psychometrics/factors/*.png
!public/horoscope/zodiac/*.png
!public/saju/zodiac/*.png
!public/tarot/cards/*.png

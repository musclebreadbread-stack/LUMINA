    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^3.2.4",
    "astronomia": "4.2.0",
    "docx": "^9.7.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "lunar-javascript": "1.7.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"

    "astronomy-engine": "2.1.19",
    "better-auth": "1.7.6",
    "korean-lunar-calendar": "0.4.0",
    "luxon": "3.7.2",
    "lz-string": "1.5.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "next-intl": "^4.13.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.29.0",

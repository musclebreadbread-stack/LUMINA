# Public site origin used for metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Explicit runtime environment; Railway should set this to staging or production.
APP_ENV=development

# Server-only AES-256-GCM key for short-lived encrypted birth-report cookies.
# Generate a separate 32-byte key for each environment.
# REPORT_SESSION_ENCRYPTION_KEY=replace-with-64-hex-characters

# Neon server-only values. DATABASE_URL is pooled for application traffic;
# use DATABASE_URL_UNPOOLED only for migrations and administrative tasks.
# DATABASE_URL=postgresql://...
# DATABASE_URL_UNPOOLED=postgresql://...
# Neon Auth sign-up must also be disabled at the provider endpoint; the app route
# below only blocks account creation through this Next.js proxy.
# NEON_AUTH_BASE_URL=https://...
# NEON_AUTH_JWKS_URL=https://...

# Generate a separate random value (at least 32 characters) for each deploy.
# It signs the HttpOnly anonymous cognitive-pilot subject cookie.
# COGNITIVE_SUBJECT_COOKIE_SECRET=replace-with-a-random-32-plus-character-secret

# Neon Auth's Next.js adapter also requires an app-owned cookie secret when
# account-auth routes are enabled. Keep it server-only.
# NEON_AUTH_COOKIE_SECRET=replace-with-a-random-32-plus-character-secret

# Optional: leave unset until a real AdSense publisher account and consent setup are ready.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# Optional: public contact address shown on /contact. While unset, that page stays
# noindex and is kept out of the sitemap rather than publishing an address nobody reads.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Korean e-commerce disclosure (전자상거래법 사업자정보 + 통신판매업 신고번호,
# 정보통신망법 호스팅 제공자 표시), shown globally by BusinessInfoFooter. All six
# must be set together — the footer renders nothing until every field is present,
# rather than publishing a half-complete legal disclosure.
# NEXT_PUBLIC_SELLER_NAME=
# NEXT_PUBLIC_SELLER_REGISTRATION_NUMBER=
# NEXT_PUBLIC_SELLER_ADDRESS=
# NEXT_PUBLIC_SELLER_CONTACT_EMAIL=
# NEXT_PUBLIC_SELLER_MAIL_ORDER_REGISTRATION=
# NEXT_PUBLIC_HOSTING_PROVIDER=

# Optional: KakaoTalk share button. Without this key the button is not rendered at all —
# the other share targets (X, Threads, Facebook, Web Share) need no key.
# NEXT_PUBLIC_KAKAO_JS_KEY=

# Staff-only analytics console and scheduled rollup. Keep the read token,
# worker database URLs, and cron secret server-side; never expose them through
# NEXT_PUBLIC_* variables. The worker must use `lumina_jobs_worker`, not an owner URL.
# Configure this non-secret endpoint ID only in the production deployment.
# ANALYTICS_ROLLUP_PRODUCTION_ENDPOINT_ID=ep-production-endpoint-id
# ANALYTICS_ROLLUP_DATABASE_URL=postgresql://lumina_jobs_worker:...@...-pooler.../...
# ANALYTICS_ROLLUP_DATABASE_URL_UNPOOLED=postgresql://lumina_jobs_worker:...@.../...
# INTERNAL_WEB_ORIGIN=https://staging.example.com
# CRON_SECRET=replace-with-a-random-32-plus-character-secret

# Umami is private on Railway. The Next.js web service proxies only the tracker script and send endpoint.
# UMAMI_INTERNAL_ORIGIN=http://umami.railway.internal:3000
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://lumina.jack.ai.kr/api/umami/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-4000-8000-000000000000
# UMAMI_API_URL=http://umami.railway.internal:3000/api
# UMAMI_API_KEY=replace-with-a-read-only-umami-api-key

# Sentry browser DSN is public by design; the server DSN and enable flag stay server-only.
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
# SENTRY_SERVER_ENABLED=false
# NEON_ALLOW_PRODUCTION=1 # required only for explicit production migration/import commands

# Server-only release flags; all features remain disabled unless set to `true`.
# FEATURE_MEMBER_AUTH=false
# FEATURE_BILLING=false
# FEATURE_AI_NARRATIVE=false
# FEATURE_LS=false
# FEATURE_LUMINA_PLUS=false
# Phase 9 features default off. Each feature also requires its matching policy approval below.
# FEATURE_DEEP_SAJU=false
# FEATURE_DEEP_COMPATIBILITY=false
# FEATURE_DEEP_TAROT=false
# FEATURE_TYPE_CAREER=false
# FEATURE_REFERRALS=false
# FEATURE_GIFTS=false
# FEATURE_PRICING_EXPERIMENTS=false
# FEATURE_MARKETING_RETENTION=false
# FEATURE_SUPPORT_CASES=false
# DEEP_SAJU_PRODUCT_APPROVED=false # product DoD, licensing, price, and legal review must be complete
# DEEP_COMPATIBILITY_PRODUCT_APPROVED=false
# DEEP_TAROT_PRODUCT_APPROVED=false
# TYPE_CAREER_PRODUCT_APPROVED=false
# REFERRAL_POLICY_APPROVED=false # reward and eligibility policy must be approved
# GIFT_POLICY_APPROVED=false # refunds, transfer, recipient, and delivery policy must be approved
# PRICING_EXPERIMENTS_POLICY_APPROVED=false # price test and disclosure policy must be approved
# MARKETING_RETENTION_POLICY_APPROVED=false # consent, cadence, unsubscribe, and content rules must be approved
# MARKETING_RETENTION_POLICY_VERSION= # set only with the approved marketing policy
# SUPPORT_CASES_POLICY_APPROVED=false # service, retention, and privacy rules must be approved
# The growth worker URL is server-only; leave unset until an approved worker is implemented.
# GROWTH_DATABASE_URL=postgresql://lumina_growth_worker:...@...-pooler.../...
# BILLING_PROVIDER=toss
# REPORTING_KRW_PER_USD= # optional, finance-reviewed reporting rate; AI cost ratio stays blank until configured

# Billing workers remain disabled until database, legal, PG, and mail setup is approved.
# Use the lumina_billing_worker role; never use an owner or service-role URL here.
# BILLING_DATABASE_URL=postgresql://lumina_billing_worker:...@...-pooler.../...
# BILLING_CRON_SECRET=replace-with-a-random-32-plus-character-secret
# BILLING_RECONCILE_ENABLED=false
# BILLING_RECEIPTS_ENABLED=false
# BILLING_RECEIPT_FROM=LUMINA <receipt@example.com>
# BILLING_RECEIPT_REPLY_TO=help@example.com
# In APP_ENV=staging only, billing/subscription emails go solely to these addresses
# (comma-separated), even if a rehearsal runs against production-shaped data.
# BILLING_STAGING_RECEIPT_ALLOWLIST=qa@example.com,tester@example.com
# BILLING_LEGAL_DOCUMENTS_APPROVED=false
# BILLING_ENCRYPTION_KEY=replace-with-64-hex-characters
# BILLING_ENCRYPTION_KEY_VERSION=1
# BILLING_USER_REF_HMAC_KEY=replace-with-a-random-32-plus-character-secret
# BILLING_TERMS_VERSION=terms-2026-09-draft
# BILLING_WITHDRAWAL_NOTICE_VERSION=withdrawal-2026-09-draft
# BILLING_EU_WITHDRAWAL_WAIVER_VERSION=eu-waiver-2026-09-draft
# TOSS_BILLING_APPROVED=false # set only after Toss completes the separate recurring-payment contract
# SUBSCRIPTION_LEGAL_DOCUMENTS_APPROVED=false # set only after counsel approves renewal and cancellation notices
# SUBSCRIPTION_TERMS_VERSION=subscription-terms-2026-09-draft
# SUBSCRIPTION_RENEWAL_NOTICE_VERSION=renewal-notice-2026-09-draft
# SUBSCRIPTION_RENEWAL_PRICE_VERSION=renewal-price-2026-09-draft
# SUBSCRIPTION_CRON_SECRET=replace-with-a-random-32-plus-character-secret
# SUBSCRIPTION_ENABLED=false
# SUBSCRIPTION_FROM=LUMINA <subscription@example.com>

# AI pipeline remains off until counsel, source licensing, expert review, and the
# citation/claim golden-set gate are approved. The AI worker role is server-only.
# FEATURE_AI_NARRATIVE=false
# AI_DATABASE_URL=postgresql://lumina_ai_worker:...@...-pooler.../...
# AI_CRON_SECRET=replace-with-a-random-32-plus-character-secret
# AI_NARRATIVE_LEGAL_APPROVED=false
# AI_GOLDEN_SET_APPROVED=false
# AI_FACT_SOURCES_APPROVED=false
# AI_LICENSE_APPROVED=false # set only after all paid-content inputs are licensed
# YEAR_FORECAST_EXPERT_REVIEW_APPROVED=false
# AI_USER_REF_HMAC_KEY=replace-with-a-random-32-plus-character-secret
# AI_DAILY_BUDGET_USD=5.00
# AI_MAX_REQUEST_COST_USD=0.05
# OPENROUTER_API_KEY=replace-with-server-only-openrouter-api-key
# OPENROUTER_MODEL=provider/model-id

# Member authentication (Better Auth). The URL must use the dedicated
# lumina_auth_app role with access limited to the identity schema.
# BETTER_AUTH_URL=https://example.com
# BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
# IDENTITY_DATABASE_URL=postgresql://lumina_auth_app:...@...-pooler.../...
# MEMBER_DATABASE_URL=postgresql://lumina_member_app:...@...-pooler.../...
# RESEND_API_KEY=re_...
# AUTH_EMAIL_FROM=LUMINA <auth@example.com>
# MEMBER_TERMS_VERSION=terms-2026-09-draft
# MEMBER_PRIVACY_VERSION=privacy-2026-09-draft
# MEMBER_TRANSFER_VERSION=transfer-2026-09-draft
# MEMBER_LEGAL_DOCUMENTS_APPROVED=false # change only after counsel approves the published documents
# MEMBER_ENCRYPTION_CURRENT_KEY_VERSION=1
# MEMBER_ENCRYPTION_KEY_V1=replace-with-64-hex-characters
# MEMBER_AUTH_TURNSTILE_SECRET_KEY=replace-with-server-only-secret
# MEMBER_AUTH_TURNSTILE_SITE_KEY=replace-with-public-site-key
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Optional, staff/internal only. Leave unset in production unless a design review is
# actively in progress. When set (>=32 chars), enables /cognitive/internal-preview,
# which renders StandardizedResult with synthetic (never real) IQ/percentile values
# behind a matching ?token= query parameter. Rotate after each review.
# COGNITIVE_INTERNAL_PREVIEW_TOKEN=replace-with-a-random-32-plus-character-secret

# Public site origin used for metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon server-only values. DATABASE_URL is pooled for application traffic;
# use DATABASE_URL_UNPOOLED only for migrations and administrative tasks.
# DATABASE_URL=postgresql://...
# DATABASE_URL_UNPOOLED=postgresql://...
# NEON_AUTH_BASE_URL=https://...
# NEON_AUTH_JWKS_URL=https://...

# Generate a separate random value (at least 32 characters) for each deploy.
# It signs the HttpOnly anonymous cognitive-pilot subject cookie.
# COGNITIVE_SUBJECT_COOKIE_SECRET=replace-with-a-random-32-plus-character-secret

# Neon Auth's Next.js adapter also requires an app-owned cookie secret when
# account-auth routes are enabled. Keep it server-only.
# NEON_AUTH_COOKIE_SECRET=replace-with-a-random-32-plus-character-secret

# Optional: leave unset until a real AdSense publisher account and consent setup are ready.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# Optional: public contact address shown on /contact. While unset, that page stays
# noindex and is kept out of the sitemap rather than publishing an address nobody reads.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Optional: KakaoTalk share button. Without this key the button is not rendered at all —
# the other share targets (X, Threads, Facebook, Web Share) need no key.
# NEXT_PUBLIC_KAKAO_JS_KEY=

# Staff-only analytics console and nightly rollup. Keep the read token and
# admin database URL in the approved local admin env file; never expose them
# through NEXT_PUBLIC_* variables.
# VERCEL_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...
# VERCEL_ANALYTICS_READ_TOKEN=replace-with-a-server-only-read-token
# Rollup writers are production-only; a non-production VERCEL_ANALYTICS_ENVIRONMENT value is rejected.
# CRON_SECRET=replace-with-a-random-32-plus-character-secret
# ANALYTICS_ROLLUP_DATABASE_URL=postgresql://... # server-only owner/admin connection for the cron worker

# Optional, staff/internal only. Leave unset in production unless a design review is
# actively in progress. When set (>=32 chars), enables /cognitive/internal-preview,
# which renders StandardizedResult with synthetic (never real) IQ/percentile values
# behind a matching ?token= query parameter. Rotate after each review.
# COGNITIVE_INTERNAL_PREVIEW_TOKEN=replace-with-a-random-32-plus-character-secret
